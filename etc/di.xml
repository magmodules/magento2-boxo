<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Magmodules\Boxo\Api\Config\RepositoryInterface"
                type="Magmodules\Boxo\Model\Config\Repository"/>
    <preference for="Magmodules\Boxo\Api\Log\RepositoryInterface"
                type="Magmodules\Boxo\Model\Log\Repository"/>
    <preference for="Magmodules\Boxo\Api\Selftest\RepositoryInterface"
                type="Magmodules\Boxo\Model\Selftest\Repository"/>

    <type name="Magmodules\Boxo\Model\Selftest\Repository">
        <arguments>
            <argument name="testList" xsi:type="array">
                <item name="phpVersion" xsi:type="object">Magmodules\Boxo\Service\Test\PhpVersion</item>
                <item name="magentoVersion" xsi:type="object">Magmodules\Boxo\Service\Test\MagentoVersion</item>
                <item name="extensionStatus" xsi:type="object">Magmodules\Boxo\Service\Test\ExtensionStatus</item>
                <item name="packagingProducts" xsi:type="object">Magmodules\Boxo\Service\Test\PackagingProducts</item>
                <item name="apiConnection" xsi:type="object">Magmodules\Boxo\Service\Test\ApiConnection</item>
                <item name="extensionVersion" xsi:type="object">Magmodules\Boxo\Service\Test\ExtensionVersion</item>
            </argument>
        </arguments>
    </type>

    <!-- Logger Start -->
    <virtualType name="MagmodulesBoxoDebugLogger" type="Monolog\Logger">
        <arguments>
            <argument name="name" xsi:type="string">MagmodulesBoxoDebug</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">Magmodules\Boxo\Logger\Handler\Debug</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="MagmodulesBoxoErrorLogger" type="Monolog\Logger">
        <arguments>
            <argument name="name" xsi:type="string">MagmodulesBoxoError</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">Magmodules\Boxo\Logger\Handler\Error</item>
            </argument>
        </arguments>
    </virtualType>

    <!-- Inject virtual Monolog loggers into custom wrapper classes -->
    <type name="Magmodules\Boxo\Logger\DebugLogger">
        <arguments>
            <argument name="logger" xsi:type="object">MagmodulesBoxoDebugLogger</argument>
        </arguments>
    </type>
    <type name="Magmodules\Boxo\Logger\ErrorLogger">
        <arguments>
            <argument name="logger" xsi:type="object">MagmodulesBoxoErrorLogger</argument>
        </arguments>
    </type>
    <!-- Logger End -->

    <!--
        Feed the chosen packaging into the order grid so it can be shown as a
        column and filtered on. Orders placed before this extension keep a NULL
        here and render an empty cell.
    -->
    <virtualType name="Magento\Sales\Model\ResourceModel\Order\Grid">
        <arguments>
            <argument name="columns" xsi:type="array">
                <item name="boxo_packaging" xsi:type="string">sales_order.boxo_packaging</item>
            </argument>
        </arguments>
    </virtualType>

    <!-- Mark API keys as sensitive -->
    <type name="Magento\Config\Model\Config\TypePool">
        <arguments>
            <argument name="sensitive" xsi:type="array">
                <item name="magmodules_boxo/general/api_key" xsi:type="string">1</item>
                <item name="magmodules_boxo/general/sandbox_api_key" xsi:type="string">1</item>
            </argument>
            <argument name="environment" xsi:type="array">
                <item name="magmodules_boxo/general/api_key" xsi:type="string">1</item>
                <item name="magmodules_boxo/general/sandbox_api_key" xsi:type="string">1</item>
                <item name="magmodules_boxo/general/sandbox_mode" xsi:type="string">1</item>
            </argument>
        </arguments>
    </type>
</config>
