<include xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_include.xsd">
    <group id="developer" translate="label" type="text" sortOrder="900" showInDefault="0" showInWebsite="0"
           showInStore="0">
        <label>Developer</label>
        <!--
            Points the whole integration at a stand-in for the BOXO API, used by the E2E suite.
            Declared here purely so `bin/magento config:set` accepts the path — Magento validates
            config paths against system.xml. Every showIn* is 0, so it never renders in the admin
            and a merchant cannot reach it. Empty means api.boxo.nu, as always.
        -->
        <field id="api_base_url" translate="label" type="text" sortOrder="10" showInDefault="0" showInWebsite="0"
               showInStore="0" canRestore="1">
            <label>BOXO API base URL override</label>
        </field>
    </group>
</include>
