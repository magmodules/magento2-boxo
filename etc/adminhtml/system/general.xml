<include xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_include.xsd">
    <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1"
           showInStore="1">
        <label>General</label>
        <field id="version" translate="label" type="button" sortOrder="10" showInDefault="1" showInWebsite="1"
               showInStore="1">
            <label>Version</label>
            <frontend_model>Magmodules\Boxo\Block\Adminhtml\System\Config\Button\VersionCheck</frontend_model>
        </field>
        <field id="active" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1"
               showInStore="1">
            <label>Enable</label>
            <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
            <config_path>magmodules_boxo/general/active</config_path>
        </field>
        <field id="connection_heading" translate="label comment" type="text" sortOrder="30" showInDefault="1"
               showInWebsite="1" showInStore="0">
            <label>API Connection</label>
            <comment>Connect your store to BOXO with the API key from your BOXO account.</comment>
            <frontend_model>Magmodules\Boxo\Block\Adminhtml\Design\Heading</frontend_model>
        </field>
        <field id="api_key" translate="label comment" type="obscure" sortOrder="31" showInDefault="1"
               showInWebsite="1" showInStore="0">
            <label>API Key</label>
            <comment>The key from your BOXO account.</comment>
            <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
            <config_path>magmodules_boxo/general/api_key</config_path>
        </field>
        <!--
            Developer-only sandbox switches. Hidden from every scope so a
            retailer never sees a toggle they have no key for, but still part of
            the configuration structure, which is what lets bin/magento
            config:set reach them and what applies the encryption backend model
            to the key.
        -->
        <field id="sandbox_mode" translate="label" type="select" sortOrder="90" showInDefault="0"
               showInWebsite="0" showInStore="0">
            <label>Sandbox Mode</label>
            <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
            <config_path>magmodules_boxo/general/sandbox_mode</config_path>
        </field>
        <field id="sandbox_api_key" translate="label" type="obscure" sortOrder="91" showInDefault="0"
               showInWebsite="0" showInStore="0">
            <label>Sandbox API Key</label>
            <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
            <config_path>magmodules_boxo/general/sandbox_api_key</config_path>
        </field>
        <field id="api_test" translate="label comment" type="button" sortOrder="34" showInDefault="1"
               showInWebsite="1" showInStore="0">
            <label>Test Connection</label>
            <comment>Checks the key entered above against BOXO. Saving first is not needed.</comment>
            <frontend_model>Magmodules\Boxo\Block\Adminhtml\System\Config\Button\ApiTest</frontend_model>
        </field>
    </group>
</include>
