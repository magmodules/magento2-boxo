<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:DataObject/etc/fieldset.xsd">
    <scope id="global">
        <!--
            Carries the chosen packaging onto the order, so fulfillment can see
            it even when the option was free and left no line item behind.
        -->
        <fieldset id="sales_convert_quote">
            <field name="boxo_packaging">
                <aspect name="to_order"/>
            </field>
        </fieldset>
    </scope>
</config>
