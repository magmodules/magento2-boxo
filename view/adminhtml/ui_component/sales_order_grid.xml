<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <columns name="sales_order_columns">
        <!--
            Hidden by default so the grid stays as it was; a merchant enables it
            through the Columns control. Orders from before the extension was
            installed show an empty cell.
        -->
        <column name="boxo_packaging" class="Magento\Ui\Component\Listing\Columns\Column"
                component="Magento_Ui/js/grid/columns/select"
                sortOrder="100">
            <settings>
                <options class="Magmodules\Boxo\Model\Order\Source\Packaging"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">BOXO Packaging</label>
                <visible>false</visible>
            </settings>
        </column>
    </columns>
</listing>
